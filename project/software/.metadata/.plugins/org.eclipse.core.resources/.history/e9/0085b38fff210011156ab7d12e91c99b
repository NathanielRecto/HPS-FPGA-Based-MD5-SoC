/*
 * COE838 - MD5 SoC Application
 * Serial and parallel MD5 hashing using 32 FPGA engines
 *
 * Compile (serial):   arm-linux-gnueabihf-gcc -O2 -o md5_serial  main.c
 * Compile (parallel): arm-linux-gnueabihf-gcc -O2 -DPARALLEL -o md5_parallel main.c
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/mman.h>

#include "hps_0.h"

/* -- Hardware constants -------------------------------------------- */
#define LW_BRIDGE_BASE   0xFF200000UL
#define LW_BRIDGE_SPAN   0x00200000UL

#define NUM_ENGINES      32          /* total MD5 engines in md5_group */
#define MSG_WORDS        16          /* 512-bit MD5 block = 16 x 32-bit words */
#define DIGEST_WORDS     4           /* 128-bit digest = 4 x 32-bit words */
#define BENCH_ROUNDS     1000        /* iterations for throughput benchmark */

/* Control slave word offsets (byte addr = offset * 4) */
#define CTRL_START  0    /* W: start bitmask  */
#define CTRL_RESET  1    /* W: reset bitmask  */
#define CTRL_DONE   2    /* R: done  bitmask  */

/* -- Pointer helpers ----------------------------------------------- */
#define DATA_PTR(lw)  ((volatile unsigned int *)((char *)(lw) + MD5_DATA_0_BASE))
#define CTRL_PTR(lw)  ((volatile unsigned int *)((char *)(lw) + MD5_CONTROL_0_BASE))

/* -- Address encoding ---------------------------------------------- */
/*
 * Write address (9-bit):
 *   [8:5] = engine / 2  (engine-pair index, 0-15)
 *   [4:0] = word index  (message word, 0-15)
 *
 * Read address (7-bit):
 *   [6:2] = engine      (0-31)
 *   [1:0] = digest word (0-3)
 */
static inline void write_msg_word(volatile unsigned int *data,
                                   int engine, int word, unsigned int val)
{
    unsigned int addr = ((unsigned int)(engine / 2) << 5) | ((unsigned int)word & 0x1F);
    data[addr] = val;
}

static inline unsigned int read_digest_word(volatile unsigned int *data,
                                              int engine, int word)
{
    unsigned int addr = ((unsigned int)(engine & 0x1F) << 2) | ((unsigned int)word & 0x3);
    return data[addr];
}

/* -- Reset / start / wait helpers --------------------------------- */
static void reset_engines(volatile unsigned int *ctrl, unsigned int mask)
{
    volatile int i;
    ctrl[CTRL_RESET] = mask;
    for (i = 0; i < 16; i++);   /* hold reset for a few cycles */
    ctrl[CTRL_RESET] = 0;
}

static void load_message(volatile unsigned int *data, int engine,
                          const unsigned int msg[MSG_WORDS])
{
    int i;
    for (i = 0; i < MSG_WORDS; i++)
        write_msg_word(data, engine, i, msg[i]);
}

static inline void wait_done(volatile unsigned int *ctrl, unsigned int mask)
{
    while ((ctrl[CTRL_DONE] & mask) != mask);
}

/* -- MD5 message padding ------------------------------------------- */
/* Builds a single padded 512-bit block from msg (length < 55 bytes).
 * Follows RFC 1321 little-endian byte order. */
static void build_md5_block(const unsigned char *msg, int len,
                              unsigned int block[MSG_WORDS])
{
    unsigned char buf[64];
    unsigned long long bit_len;
    int i;

    memset(buf, 0, sizeof(buf));
    memcpy(buf, msg, len);
    buf[len] = 0x80;

    bit_len = (unsigned long long)len * 8;
    memcpy(buf + 56, &bit_len, 8);   /* little-endian length */

    for (i = 0; i < 16; i++)
        block[i] = (unsigned int)buf[i*4]
                 | ((unsigned int)buf[i*4+1] << 8)
                 | ((unsigned int)buf[i*4+2] << 16)
                 | ((unsigned int)buf[i*4+3] << 24);
}

/* -- Serial hash: one engine, one hash ---------------------------- */
static void hash_one(volatile unsigned int *ctrl,
                      volatile unsigned int *data,
                      int engine,
                      const unsigned int msg[MSG_WORDS],
                      unsigned int digest[DIGEST_WORDS])
{
    unsigned int bit = 1u << engine;
    int i;

    reset_engines(ctrl, bit);
    load_message(data, engine, msg);
    ctrl[CTRL_START] = bit;
    wait_done(ctrl, bit);
    ctrl[CTRL_START] = 0;

    for (i = 0; i < DIGEST_WORDS; i++)
        digest[i] = read_digest_word(data, engine, i);
}

/* -- Elapsed time helper ------------------------------------------- */
static double elapsed_sec(struct timespec *a, struct timespec *b)
{
    return (b->tv_sec  - a->tv_sec) +
           (b->tv_nsec - a->tv_nsec) * 1e-9;
}

/* ------------------------------------------------------------------- */
int main(void)
{
    int fd;
    void *lw_base;
    volatile unsigned int *ctrl, *data;
    unsigned int msg[MSG_WORDS];
    struct timespec t0, t1;
    long total_hashes = 0;
    double elapsed, hash_rate;
    int e, w, r;

    /* -- Map lightweight HPS-to-FPGA bridge ----------------------- */
    fd = open("/dev/mem", O_RDWR | O_SYNC);
    if (fd < 0) { perror("open /dev/mem"); return 1; }

    lw_base = mmap(NULL, LW_BRIDGE_SPAN,
                   PROT_READ | PROT_WRITE, MAP_SHARED,
                   fd, LW_BRIDGE_BASE);
    if (lw_base == MAP_FAILED) { perror("mmap"); close(fd); return 1; }

    ctrl = CTRL_PTR(lw_base);
    data = DATA_PTR(lw_base);

    /*
     * Test message: "abc"
     * Expected MD5: 900150983cd24fb0d6963f7d28e17f72
     */
    build_md5_block((const unsigned char *)"abc", 3, msg);

    /* -- Reset everything first ----------------------------------- */
    reset_engines(ctrl, 0xFFFFFFFF);

#ifndef PARALLEL
    /* ------------------------------------------------------------
     * SERIAL MODE
     * Hash the same message on engines 0..31 one at a time.
     * ------------------------------------------------------------ */
    printf("=== SERIAL MODE (%d engines, %d rounds) ===\n",
           NUM_ENGINES, BENCH_ROUNDS);

    unsigned int digest[DIGEST_WORDS];
    unsigned int last_digest[DIGEST_WORDS];

    clock_gettime(CLOCK_MONOTONIC, &t0);

    for (r = 0; r < BENCH_ROUNDS; r++) {
        for (e = 0; e < NUM_ENGINES; e++) {
            hash_one(ctrl, data, e, msg, digest);
            total_hashes++;
        }
    }

    clock_gettime(CLOCK_MONOTONIC, &t1);
    memcpy(last_digest, digest, sizeof(digest));

    elapsed   = elapsed_sec(&t0, &t1);
    hash_rate = (double)total_hashes / elapsed;

    printf("Total hashes  : %ld\n", total_hashes);
    printf("Elapsed time  : %.6f s\n", elapsed);
    printf("Hash rate     : %.2f hashes/s  (%.4f MH/s)\n",
           hash_rate, hash_rate / 1e6);
    printf("Last digest   : %08x%08x%08x%08x\n",
           last_digest[0], last_digest[1],
           last_digest[2], last_digest[3]);
    printf("Expected      : 900150983cd24fb0d6963f7d28e17f72\n");
    printf("Result        : %s\n",
           (last_digest[0] == 0x90015098 &&
            last_digest[1] == 0x3cd24fb0 &&
            last_digest[2] == 0xd6963f7d &&
            last_digest[3] == 0x28e17f72) ? "PASS" : "FAIL");

#else
    /* ------------------------------------------------------------
     * PARALLEL MODE
     * Load all 32 engines with the same message, fire simultaneously,
     * wait for all done, read all digests.
     * ------------------------------------------------------------ */
    printf("=== PARALLEL MODE (%d engines, %d rounds) ===\n",
           NUM_ENGINES, BENCH_ROUNDS);

    unsigned int digests[NUM_ENGINES][DIGEST_WORDS];

    clock_gettime(CLOCK_MONOTONIC, &t0);

    for (r = 0; r < BENCH_ROUNDS; r++) {
        reset_engines(ctrl, 0xFFFFFFFF);

        /* Load all engines */
        for (e = 0; e < NUM_ENGINES; e++)
            load_message(data, e, msg);

        /* Start all 32 simultaneously */
        ctrl[CTRL_START] = 0xFFFFFFFF;
        wait_done(ctrl, 0xFFFFFFFF);
        ctrl[CTRL_START] = 0;

        /* Read all digests */
        for (e = 0; e < NUM_ENGINES; e++)
            for (w = 0; w < DIGEST_WORDS; w++)
                digests[e][w] = read_digest_word(data, e, w);

        total_hashes += NUM_ENGINES;
    }

    clock_gettime(CLOCK_MONOTONIC, &t1);

    elapsed   = elapsed_sec(&t0, &t1);
    hash_rate = (double)total_hashes / elapsed;

    printf("Total hashes  : %ld\n", total_hashes);
    printf("Elapsed time  : %.6f s\n", elapsed);
    printf("Hash rate     : %.2f hashes/s  (%.4f MH/s)\n",
           hash_rate, hash_rate / 1e6);

    /* Verify all engines agree */
    int all_match = 1;
    for (e = 1; e < NUM_ENGINES; e++) {
        if (memcmp(digests[e], digests[0], DIGEST_WORDS * sizeof(unsigned int))) {
            printf("MISMATCH on engine %d!\n", e);
            all_match = 0;
        }
    }
    printf("Cross-engine  : %s\n", all_match ? "All match (PASS)" : "MISMATCH (FAIL)");
    printf("Engine 0      : %08x%08x%08x%08x\n",
           digests[0][0], digests[0][1],
           digests[0][2], digests[0][3]);
    printf("Expected      : 900150983cd24fb0d6963f7d28e17f72\n");
    printf("Hash check    : %s\n",
           (digests[0][0] == 0x90015098 &&
            digests[0][1] == 0x3cd24fb0 &&
            digests[0][2] == 0xd6963f7d &&
            digests[0][3] == 0x28e17f72) ? "PASS" : "FAIL");
#endif

    munmap(lw_base, LW_BRIDGE_SPAN);
    close(fd);
    return 0;
}
